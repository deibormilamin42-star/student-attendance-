<%- include('partials/head') %>
<main class="container">
  <div class="page-head">
    <div>
      <h1><%= student.name %></h1>
      <p class="muted">Roll <%= student.roll_no %><%= student.class_name ? ' \u00b7 ' + student.class_name : '' %></p>
    </div>
    <div class="row-gap">
      <% if (user.role === 'admin') { %><a class="btn ghost" href="/students/<%= student.id %>/edit">Edit</a><% } %>
      <a class="btn ghost" href="/students">Back</a>
    </div>
  </div>

  <section class="grid stats">
    <div class="card stat ok"><span class="muted">Present</span><strong><%= sum.present %></strong></div>
    <div class="card stat warn"><span class="muted">Late</span><strong><%= sum.late %></strong></div>
    <div class="card stat bad"><span class="muted">Absent</span><strong><%= sum.absent %></strong></div>
    <div class="card stat <%= pctClass(sum.pct) %>"><span class="muted">Attendance</span><strong><%= sum.pct == null ? '\u2013' : sum.pct + '%' %></strong></div>
  </section>

  <section class="card">
    <h2>Recent attendance</h2>
    <% if (!history.length) { %>
      <p class="muted">No attendance recorded yet.</p>
    <% } else { %>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Date</th><th>Day</th><th>Status</th></tr></thead>
          <tbody>
            <% history.forEach(function (h) { %>
              <tr><td><%= pretty(h.date) %></td><td><%= weekday(h.date) %></td><td><span class="chip <%= h.status %>"><%= h.status %></span></td></tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <p class="muted small">Showing the latest 60 records.</p>
    <% } %>
  </section>
</main>
<%- include('partials/foot') %>
